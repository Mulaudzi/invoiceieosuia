<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Central identity entry points: redirect before the React shell can render.
  RewriteRule ^login/?$ /api/auth/ieosuia/start [R=302,L,NE]
  RewriteRule ^register/?$ /api/auth/ieosuia/start?screen_hint=signup [R=302,L,NE]
  RewriteRule ^guymhan/login/?$ /api/auth/ieosuia/start?account_type=admin [R=302,L,NE]
  RewriteCond %{REQUEST_URI} ^/assets/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html)?$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|svg|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
